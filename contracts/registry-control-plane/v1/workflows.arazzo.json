{
  "arazzo": "1.0.1",
  "info": {
    "title": "spio registry control-plane workflows",
    "version": "1.0.0",
    "summary": "Backend workflow descriptions built on top of the registry control-plane OpenAPI package.",
    "description": "These workflows show how backend automation and service owners coordinate against the frozen control-plane interface without depending on private implementation layout."
  },
  "sourceDescriptions": [
    {
      "name": "registryControlPlane",
      "url": "./openapi.json",
      "type": "openapi"
    }
  ],
  "workflows": [
    {
      "workflowId": "publishAndVerifyRegistryRelease",
      "summary": "Inspect a registry root, publish a release, and verify the resulting static state.",
      "inputs": {
        "type": "object",
        "properties": {
          "manifest_path": {
            "type": "string"
          },
          "publisher_id": {
            "type": "string"
          }
        },
        "required": [
          "manifest_path"
        ]
      },
      "steps": [
        {
          "stepId": "status",
          "operationId": "registryStatus",
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            },
            {
              "condition": "$response.body.returncode == 0"
            }
          ]
        },
        {
          "stepId": "publish",
          "operationId": "publishRelease",
          "requestBody": {
            "contentType": "application/json",
            "payload": {
              "manifest_path": "$inputs.manifest_path",
              "publisher_id": "$inputs.publisher_id"
            }
          },
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            },
            {
              "condition": "$response.body.returncode == 0"
            }
          ]
        },
        {
          "stepId": "verify",
          "operationId": "verifyRegistry",
          "requestBody": {
            "contentType": "application/json",
            "payload": {}
          },
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            },
            {
              "condition": "$response.body.returncode == 0"
            }
          ]
        }
      ]
    }
  ]
}
