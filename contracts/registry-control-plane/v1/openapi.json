{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "spio registry control-plane API",
    "version": "1.0.0",
    "summary": "Backend control-plane API for operating a spio registry v2 root.",
    "description": "Design-first OpenAPI package for the local or hosted registry control plane. The path family is frozen at `/api/spio-registry-control/v1`; backend services and automation may vary the host, but must preserve operation ids, request bodies, response envelopes, and example payloads."
  },
  "servers": [
    {
      "url": "{scheme}://{host}/api/spio-registry-control/v1",
      "description": "Deployment-neutral registry control-plane base URL.",
      "variables": {
        "scheme": {
          "default": "http",
          "enum": [
            "http",
            "https"
          ]
        },
        "host": {
          "default": "localhost:3010"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "registry-control",
      "description": "Operate registry v2 roots through a versioned backend service interface."
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "tags": [
          "registry-control"
        ],
        "summary": "Describe the bound registry root",
        "description": "Return a redacted control-plane status summary, initialization state, and the known route family.",
        "operationId": "registryStatus",
        "responses": {
          "200": {
            "description": "HTTP 200 returns either the status envelope or the documented domain-level failure envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/StatusEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/FailureEnvelope"
                    }
                  ]
                },
                "examples": {
                  "success": {
                    "$ref": "#/components/examples/registryStatus_success"
                  },
                  "failure": {
                    "$ref": "#/components/examples/registryStatus_failure"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/publish": {
      "post": {
        "tags": [
          "registry-control"
        ],
        "summary": "Publish a source package into the registry v2 root",
        "description": "Prepare or accept a source package artifact, append the release record, and update signed registry metadata plus the transparency log.",
        "operationId": "publishRelease",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              },
              "examples": {
                "request": {
                  "$ref": "#/components/examples/publishRelease_request"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 returns either the publish envelope or the documented domain-level failure envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PublishEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/FailureEnvelope"
                    }
                  ]
                },
                "examples": {
                  "success": {
                    "$ref": "#/components/examples/publishRelease_success"
                  },
                  "failure": {
                    "$ref": "#/components/examples/publishRelease_failure"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/verify": {
      "post": {
        "tags": [
          "registry-control"
        ],
        "summary": "Verify the registry v2 root",
        "description": "Run the static read-plane verifier against the configured registry root and return the integrity summary.",
        "operationId": "verifyRegistry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyObject"
              },
              "examples": {
                "request": {
                  "$ref": "#/components/examples/verifyRegistry_request"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 returns either the verify envelope or the documented domain-level failure envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/VerifyEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/FailureEnvelope"
                    }
                  ]
                },
                "examples": {
                  "success": {
                    "$ref": "#/components/examples/verifyRegistry_success"
                  },
                  "failure": {
                    "$ref": "#/components/examples/verifyRegistry_failure"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmptyObject": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "FailurePayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "detail"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "FailureEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "returncode",
          "message",
          "stdout",
          "stderr",
          "error_payload"
        ],
        "properties": {
          "returncode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "error_payload": {
            "$ref": "#/components/schemas/FailurePayload"
          }
        }
      },
      "StatusPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry_root",
          "key_dir",
          "registry_name",
          "root_initialized",
          "config_present",
          "root_metadata_present",
          "publish_endpoint",
          "verify_endpoint"
        ],
        "properties": {
          "registry_root": {
            "type": "string"
          },
          "key_dir": {
            "type": "string"
          },
          "registry_name": {
            "type": "string"
          },
          "root_initialized": {
            "type": "boolean"
          },
          "config_present": {
            "type": "boolean"
          },
          "root_metadata_present": {
            "type": "boolean"
          },
          "publish_endpoint": {
            "type": "string"
          },
          "verify_endpoint": {
            "type": "string"
          }
        }
      },
      "StatusEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "returncode",
          "message",
          "stdout",
          "stderr",
          "payload"
        ],
        "properties": {
          "returncode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/StatusPayload"
          }
        }
      },
      "PublishRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "archive_path": {
            "type": "string"
          },
          "manifest_path": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "output_path": {
            "type": "string"
          },
          "publisher_id": {
            "type": "string"
          }
        }
      },
      "PublishPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry_root",
          "created_root",
          "package",
          "version",
          "publisher_id",
          "published_at",
          "archive_path",
          "archive_sha256",
          "archive_size_bytes",
          "artifact_path",
          "index_path",
          "log_leaf_path",
          "sequence",
          "dependencies",
          "dev_dependencies"
        ],
        "properties": {
          "registry_root": {
            "type": "string"
          },
          "created_root": {
            "type": "boolean"
          },
          "package": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "publisher_id": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "archive_path": {
            "type": "string"
          },
          "archive_sha256": {
            "type": "string"
          },
          "archive_size_bytes": {
            "type": "integer"
          },
          "artifact_path": {
            "type": "string"
          },
          "index_path": {
            "type": "string"
          },
          "log_leaf_path": {
            "type": "string"
          },
          "sequence": {
            "type": "integer"
          },
          "dependencies": {
            "type": "integer"
          },
          "dev_dependencies": {
            "type": "integer"
          }
        }
      },
      "PublishEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "returncode",
          "message",
          "stdout",
          "stderr",
          "payload"
        ],
        "properties": {
          "returncode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/PublishPayload"
          }
        }
      },
      "VerifyPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "root",
          "namespaces",
          "index_files",
          "releases",
          "tree_size"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "root": {
            "type": "string"
          },
          "namespaces": {
            "type": "integer"
          },
          "index_files": {
            "type": "integer"
          },
          "releases": {
            "type": "integer"
          },
          "tree_size": {
            "type": "integer"
          }
        }
      },
      "VerifyEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "returncode",
          "message",
          "stdout",
          "stderr",
          "payload"
        ],
        "properties": {
          "returncode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/VerifyPayload"
          }
        }
      }
    },
    "examples": {
      "registryStatus_success": {
        "value": {
          "returncode": 0,
          "message": "registry control plane is ready",
          "stdout": "",
          "stderr": "",
          "payload": {
            "registry_root": "/srv/spio-registry-v2",
            "key_dir": "/srv/spio-registry-v2-keys",
            "registry_name": "production-registry",
            "root_initialized": true,
            "config_present": true,
            "root_metadata_present": true,
            "publish_endpoint": "/api/spio-registry-control/v1/publish",
            "verify_endpoint": "/api/spio-registry-control/v1/verify"
          }
        }
      },
      "registryStatus_failure": {
        "value": {
          "returncode": 17,
          "message": "registry status failed",
          "stdout": "",
          "stderr": "registry root is unreadable",
          "error_payload": {
            "category": "RegistryStatusError",
            "detail": "registry root is unreadable"
          }
        }
      },
      "publishRelease_request": {
        "value": {
          "manifest_path": "/workspace/demo/spio.toml",
          "publisher_id": "console-user"
        }
      },
      "publishRelease_success": {
        "value": {
          "returncode": 0,
          "message": "published registry v2 release",
          "stdout": "",
          "stderr": "",
          "payload": {
            "registry_root": "/srv/spio-registry-v2",
            "created_root": true,
            "package": "demo/app",
            "version": "0.1.0",
            "publisher_id": "console-user",
            "published_at": "2026-04-21T00:00:00Z",
            "archive_path": "/tmp/demo/app-0.1.0.tar",
            "archive_sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "archive_size_bytes": 4096,
            "artifact_path": "artifacts/source/sha256/01/23/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef.spio.src.tar",
            "index_path": "index/demo/app.jsonl",
            "log_leaf_path": "log/leaves/000000000001.json",
            "sequence": 1,
            "dependencies": 0,
            "dev_dependencies": 0
          }
        }
      },
      "publishRelease_failure": {
        "value": {
          "returncode": 17,
          "message": "registry publish failed",
          "stdout": "",
          "stderr": "package version is already published",
          "error_payload": {
            "category": "PublishError",
            "detail": "package version is already published"
          }
        }
      },
      "verifyRegistry_request": {
        "value": {}
      },
      "verifyRegistry_success": {
        "value": {
          "returncode": 0,
          "message": "verified registry v2 root",
          "stdout": "",
          "stderr": "",
          "payload": {
            "ok": true,
            "root": "/srv/spio-registry-v2",
            "namespaces": 1,
            "index_files": 1,
            "releases": 2,
            "tree_size": 2
          }
        }
      },
      "verifyRegistry_failure": {
        "value": {
          "returncode": 17,
          "message": "registry verification failed",
          "stdout": "",
          "stderr": "checkpoint hash mismatch",
          "error_payload": {
            "category": "VerifyError",
            "detail": "checkpoint hash mismatch"
          }
        }
      }
    }
  }
}
